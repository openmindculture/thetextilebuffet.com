---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonicalUrl = 'https://thetextilebuffet.com/';

import '../styles/styles.css';
import criticalStyles from '../styles/critical.css?inline';
---
<head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel=canonical href={canonicalUrl}>
    <meta name=viewport content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="/fonts/work-sans-v24-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/karla-v33-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <style set:html={criticalStyles} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name=robots content="index,follow">
    <meta name="description" content={description} />
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content="https://thetextilebuffet.com/">
    <meta property="og:site_name" content="The TEXTILE BUFFET">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://thetextilebuffet.com/The-Texite-Buffet-screenshot-preview.jpg">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context":"http://schema.org",
        "@type":"Organization",
        "name": title,
        "image":"https://thetextilebuffet.com/The-Texite-Buffet-screenshot-preview.jpg",
        "logo":"https://thetextilebuffet.com/logo-thetextilebuffet.path.svg",
        "description": description,
        "url": canonicalUrl
    })} />
</head>