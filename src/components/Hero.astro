---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../images/intro/*.{jpg,jpeg,png}', { eager: true })
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---
<div class="decoration">
  {images.map((img, index) => (
    <Picture
      src={img}
      class={index > 0 ? 'visually-hidden' : ''}
      alt=""
      widths={[400, 800]}
      sizes="(max-width: 800px) 100vw, 800px"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading="eager"
    />
  ))}
</div>
