---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'The Textile Buffet | Curated Materials & Styling';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
const noLogo = true;
---
<BaseLayout {title} {noLogo}>
    <h1>
        <img src="/logos/logo-thetextilebuffet-curated-text-cream-color-shadow.svg" alt={title + ' – ' + description } width="396" height="56">
    </h1>

    <p>
        Step up to a beautifully curated material buffet filled with fabrics, buttons, ribbons and reclaimed treasures. Choose what catches your eye, experiment with colour and texture, and turn what you find into a personal detail for your clothing, bag or accessories.
    </p>
    <h2>The Concept</h2>
    <p>
        Think of The Textile Buffet as a material library and a styling installation in one, a textile treasure hunt where every dish on the table is an invitation. Come with an idea in mind, or come with none at all.<br>
        Pick what speaks to you, or let one of our prompts guide you.
        You'll leave with a one-of-one piece made by your own hands, in a space designed to slow you down and reconnect you with the material and the making.
    </p>
    <h2>Formats</h2>
    <p>
        Personal, corporate, bridal, and other editions organized by us, tailored to your occasion, group, and creative appetite.
    </p>
</BaseLayout>
