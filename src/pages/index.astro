---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'The Textile Buffet | Curated Materials & Styling';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
---
<BaseLayout {title} {description}>
    <h1>
      <a href="/concept/">
        <img src='/logos/textile-buffet-logo-400x140-lemon-transparent-shadow.png' alt={title} width="1600" height="560">
      </a>
    </h1>
  <a class="buttonlike shadowlesstext boxshadow" href="events/">Save the date: 21-22 November 2026, The Gallery of Things, Berlin</a>
</BaseLayout>
