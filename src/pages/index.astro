---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'The Textile Buffet | Curated Materials & Styling';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
---
<BaseLayout {title} {description}>
    <h1>
      <a href="/concept/">
        <img src='/logos/textile-buffet-logo-1244x201-lemon-transparent-shadow.png' alt={title} width="1768" height="440">
      </a>
    </h1>
  <a class="buttonlike shadowlesstext boxshadow" href="events/">Save the date: 14. - 15.11.26 LOOPTOPIA, Berlin</a>
</BaseLayout>
