---
import BaseLayout from '../layouts/BaseLayout.astro';
import organizer from '../data/organizer';
import MapMarkerIcon from '../icons/mapmarker.svg';
const title = 'The Textile Buffet: Events';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
---
<BaseLayout {title} {description}>
    <h1>
      Events
    </h1>

    <ul>
        <li>
          <h2>
            <a href="https://www.tickettailor.com/events/thetextilebuffet/2362137" target="_blank">
              23.08.2026 The TEXTILE BUFFET at Lillimendelssohn, Berlin
            </a>
          </h2>
          <div class="flex-has-logos">
            <MapMarkerIcon />
            <a href="https://maps.app.goo.gl/rsMUeNSgq3LP7G6u5" target="_blank">
              Sun 23 Aug 2026 14:00 - 16:30<br>
              Lillimendelssohn, Knesebeckstr. 27, 10623 Berlin, 10623
            </a>
          </div>
            <p>
                This edition takes place at Lillimendelssohn, a Berlin knitwear label known for its distinctive use of colour, beautiful yarns and timeless design.
            </p>

            <ul>
              <li>2.5 hours of guided, hands-on making</li>
              <li>All materials included: reclaimed fabrics, ribbons, buttons, beads, findings and more</li>
              <li>No experience needed. Beginners and crafty hands alike are equally welcome</li>
              <li>Two ways in: bring your own idea and build it at the buffet, or follow one of our simple guided designs</li>
              <li>Take home a wearable piece, a brooch, bow, ornament or accessory that's entirely your own</li>
              <li>No skills required. No pressure.</li>
              <li>Just good materials, good company, and a little time away from the screen.</li>
            </ul>

          <a class="buttonlike float-right" href="https://www.tickettailor.com/events/thetextilebuffet/2362137" target="_blank">get your ticket</a>

            <p><b>Price:</b> €55 per person</p>
            <p><b>Spots:</b> Limited to 8 people.</p>

            <script is:inline type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Event",
                "name": "Berlin Tech Conference 2026",
                "startDate": "2026-09-15T09:00:00+02:00",
                "endDate": "2026-09-17T18:00:00+02:00",
                "eventStatus": "https://schema.org/EventScheduled",
                "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
                "location": {
                "@type": "Place",
                "name": "Berlin Convention Center",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Messedamm 22",
                    "addressLocality": "Berlin",
                    "postalCode": "14055",
                    "addressCountry": "DE"
                }
                },
                "image": "https://example.com/berlin-tech-conference.jpg",
                "description": "A 3-day conference for tech enthusiasts, developers, and innovators.",
                organizer,
                })} />
        </li>
    </ul>
</BaseLayout>
