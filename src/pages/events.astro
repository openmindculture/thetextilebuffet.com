---
import BaseLayout from '../layouts/BaseLayout.astro';
import organizer from '../data/organizer';
import MapMarkerIcon from '../icons/mapmarker.svg';
const title = 'The Textile Buffet: Events';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
---
<BaseLayout {title} {description}>
    <h1>
      Events
    </h1>

    <ul class="events">
      <li>
        <h2>
          <a href="https://www.tickettailor.com/events/thetextilebuffet/2474235?date=2026-11-21" target="_blank">
            21.-22.11.2026 The Gallery of Things, Berlin
          </a>
        </h2>
        <div class="flex-has-logos">
          <MapMarkerIcon />
          <a href="https://www.google.com/maps?cid=0x47a85bb9fa1524f7:0xaa2ad2c3f09eefd5" target="_blank">
            Sat 21 + Sun 22 November 2026<br>
            The Gallery of Things, Potsdamer Str. 52-54, 14163 Berlin - Zehlendorf
          </a>
        </div>

        <ul>
          <li>Saturday 21 November 5 - 7:30 p.m.</li>
          <li>Sunday 22 November 12 - 2:30 p.m.</li>
          <li>Sunday 22 November 3:30 - 6 p.m.</li>

        </ul>

        <a class="buttonlike float-right" href="https://www.tickettailor.com/events/thetextilebuffet/2474235?date=2026-11-21" target="_blank">get your ticket</a>

        <h3>Unmuse yourself, one detail at a time.</h3>
        <p>
          For centuries, the muse was adorned, dressed and styled by others. The TEXTILE BUFFET is a participatory installation that hands this power back to you.
        </p>
        <p>
          Laid out like a banquet, an abundance of reclaimed materials, sourced from flea markets, vintage collections and local designers, waits for you to become the curator. Pick what catches your eye, then, at the makers' table, combine, rearrange and shape your selection into a singular wearable detail.
        </p>
        <p>
          Every fragment carries someone else's story. In your hands, it finds a new voice, and you become muse and maker at once.
        </p>
        <p>
          This special edition takes place at The Gallery of Things in Zehlendorf in the context of the exhibition UNMUSED.
        </p>
        <p>
          It's the perfect occasion to bring a friend, and we've put together a special rate for two ;)
        </p>

        What's included:<br>
        <br>
        <ul>
          <li>2.5 hours at the makers' table</li>
          <li>All materials and tools provided</li>
          <li>No experience needed, beginners and crafty hands alike are equally welcome</li>
          <li>Two ways in: bring your own idea and build it at the buffet, or let one of our prompts guide you</li>
          <li>Leave with a one-of-one wearable detail, made by your own hands</li>
        </ul>

        <p><b>Price:</b> € 55,- per person, € 80,- for two</p>
        <p><b>Spots:</b> Limited to 8 people per session.</p>

        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Event",
          "name": "The TEXTILE BUFFET at The Gallery of Things, Berlin",
          "startDate": "2026-11-21T19:30:00+02:00",
          "endDate": "2026-11-22T18:00:00+02:00",
