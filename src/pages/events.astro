---
import BaseLayout from '../layouts/BaseLayout.astro';
import organizer from '../data/organizer';
import MapMarkerIcon from '../icons/mapmarker.svg';
const title = 'The Textile Buffet: Events';
const description = 'Step up to a beautifully curated material buffet filled with fabrics, buttons, and reclaimed treasures. Turn what you find into personal clothing details.'
---
<BaseLayout {title} {description}>
    <h1>
      Events
    </h1>

    <ul class="events">
      <li>
        <h2>
          <a href="https://www.tickettailor.com/events/thetextilebuffet/2362137" target="_blank">
            26.-27.09.2026 The TEXTILE BUFFET at Atelier ROSSA, Berlin
          </a>
        </h2>
        <div class="flex-has-logos">
          <MapMarkerIcon />
          <a href="https://www.google.com/maps?cid=0x47a8511db49173a9:0xc6c6328c0b174c4a" target="_blank">
            Sat 26 + Sun 27 September 2026<br>
            Atelier ROSSA, Barbarossastr. 61, 10781 Berlin
          </a>
        </div>
        <p>
          The Textile Buffet in September 2026 takes place at Atelier ROSSA, a studio for fashion, design and art of living in Berlin Schöneberg.
        </p>

        <ul>
          <li>Saturday 26 September 6 - 8 p.m.</li>
          <li>Sunday 27 September 13 - 15 p.m.</li>
          <li>Sunday 27 September 4 - 6 p.m.</li>
          <li>Save the date,</li>
          <li>more information and booking coming up soon!</li>
        </ul>

        <a class="buttonlike float-right" href="https://www.tickettailor.com/events/thetextilebuffet/2406271" target="_blank">get your ticket</a>

        <p><b>Price:</b> € 45,- per person</p>
        <p><b>Spots:</b> Limited to 8 people per session.</p> -->
What's included:
<ul>
<li>2 hours of guided, hands-on making</li>
   <li>All materials and tools provided</li>
    <li>No experience needed, beginners and crafty hands alike are equally welcome</li>
    <li>Two ways in: bring your own idea and build it at the buffet, or follow one of our simple guided designs</li>
    <li>Take home a wearable piece (brooch, earrings, hairpiece, bag charm or ornament)</li> 
</ul>


