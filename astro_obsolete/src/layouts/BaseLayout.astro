---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  hasFooter?: boolean;
  noLogo?: boolean;
}
const { title, description, hasFooter, noLogo } = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!DOCTYPE html>
<html lang="en">
    <Head {title} {description} />
    <body itemtype="https://schema.org/WebPage" itemscope class:list={['', { home: isHome }]}>
        {isHome && (<Hero />)}
        <Header {noLogo} />
        <main>
            <slot />
        </main>
        {hasFooter && (<Footer />)}
        {isHome && (
            <script>
                import '../scripts/decoration-rotator';
            </script>
        )}
    </body>
</html>
